# Copy to .env -- never versioned (see .gitignore)
# Covers: EC19

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ml4fd-1

# Pepper for the pseudonymisation HMAC. Generate with: .\fd-manager.ps1 setup
# It must appear neither in governance.yml nor in the repository.
ML4FD_PEPPER=

AIRFLOW_UID=50000
MLFLOW_TRACKING_URI=http://mlflow:5000

# Password of fd_dashboard, the role the dashboard logs in as (S6/R0).
# Generated by .\fd-manager.ps1 setup, applied by .\fd-manager.ps1 init.
FD_DASHBOARD_PASSWORD=

# Password of fd_scoring_service, the role the scoring service logs in as (L5).
# Generated by `fd-manager.ps1 setup`, applied by `init`. Never versioned.
FD_SCORING_SERVICE_PASSWORD=

# Passwords of fd_airflow and fd_mlflow, the owners of the two service
# databases (L1). Generated by .\fd-manager.ps1 setup.
#
# READ AT FIRST BOOT, not by init: sql/initdb/010_databases.sh creates the
# roles with them before the server takes its first outside connection.
# Changing a value afterwards does NOT change the role -- the cluster is
# already initialised. Apply it by hand, or drop the volume.
AIRFLOW_DB_PASSWORD=
MLFLOW_DB_PASSWORD=

# ---------------------------------------------------------------- the corpora
# WHERE THE TWO CSV FILES COME FROM. Since 2026-11-19 both live in a private
# S3 bucket: fraudTrain.csv, which the model is trained on, and fraudTest.csv,
# which tools/replay_api.py serves as the stream. governance.yml declares their
# KEYS; the bucket is here because its name carries an AWS account number, and
# a versioned file is the wrong place for one.
#
# OPTIONAL. Needed only for the first download: fetch_csv records each file in
# .local_cache/ with its sha256, and later runs take the cache. A stack whose
# cache is warm needs none of these four lines, which is why Assert-Env does
# not require them.
ML4FD_CORPUS_BUCKET=
# Read by boto3 itself, never by this project's code.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3
